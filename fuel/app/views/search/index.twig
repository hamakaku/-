{% extends "layout.twig" %}

{#
  仮の予約フォーム（仕様書「2 検索画面」は追加課題のため、それまでの代わり）
  講師・コース・予約日・時間を選んで POST reserve に送る
    送信する項目: instructorId / course / date（Y-m-d） / time（9〜20）

  渡される値: title / instructors / courses / input（入力値） / min_date / max_date
              errors（入力エラーのとき）
#}

{% block main %}
<main>
  <h1>{{ title }}</h1>
  <p class="page-lead">ご希望の講師・コース・日時を選択してください。</p>

  {% if errors is defined and errors %}
    <div class="alert alert-danger" role="alert">
      <p class="alert-heading">選択内容を確認してください。</p>
      {% for message in errors %}<p>{{ message }}</p>{% endfor %}
    </div>
  {% endif %}

  <form action="{{ base_url() }}reserve" method="post" class="reservation-form">
    <div class="form-group">
      <label for="instructorId">講師</label>
      <select id="instructorId" name="instructorId" class="form-select" required>
        {% for instructor in instructors %}
        <option value="{{ instructor.id }}" {% if input.instructorId|default('') == instructor.id %}selected{% endif %}>{{ instructor.name }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="form-group">
      <label for="course">コース</label>
      <select id="course" name="course" class="form-select" required>
        {% for course in courses %}
        <option value="{{ course.id }}" {% if input.course|default('') == course.id %}selected{% endif %}>{{ course.name }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="form-group">
      <label for="date">予約日</label>
      <input id="date" class="form-control" type="date" name="date" min="{{ min_date }}" max="{{ max_date }}" value="{{ input.date|default(min_date) }}" required>
      <p class="form-text">翌日から来月末まで選択できます。</p>
    </div>
    <div class="form-group">
      <label for="time">時間</label>
      <select id="time" name="time" class="form-select" required>
        {% for i in 9..20 %}
        <option value="{{ i }}" {% if input.time|default('') == i %}selected{% endif %}>{{ i }}:00</option>
        {% endfor %}
      </select>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">予約へ進む</button>
    </div>
  </form>
</main>
{% endblock main %}
