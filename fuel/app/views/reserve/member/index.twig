{% extends "layout.twig" %}

{% block main %}
  {% autoescape 'html' %}
    <main class="page-card registration-page">
      <header class="page-heading">
        <p class="page-heading__eyebrow">MEMBER REGISTRATION</p>
        <h1>会員登録情報入力</h1>
        <p>予約に必要な情報を入力してください。入力内容は次の画面で確認できます。</p>
      </header>

      <ol class="booking-steps" aria-label="予約手順">
        <li class="is-current" aria-current="step"><span>1</span>情報入力</li>
        <li><span>2</span>登録確認</li>
        <li><span>3</span>予約確認</li>
        <li><span>4</span>完了</li>
      </ol>

      <div class="registration-layout">
        <aside class="registration-aside">
          {% if data %}
            <section class="reservation-summary" aria-labelledby="reservation-summary-heading">
              <p class="reservation-summary__label">YOUR LESSON</p>
              <h2 id="reservation-summary-heading">予約内容</h2>
              <dl>
                <div>
                  <dt>講師</dt>
                  <dd>{{ data.instructor.name }}</dd>
                </div>
                <div>
                  <dt>コース</dt>
                  <dd>{{ data.course.name }}</dd>
                </div>
                <div>
                  <dt>日時</dt>
                  <dd>{{ data.date.year }}年{{ data.date.month }}月{{ data.date.day }}日（{{ data.date.week }}）<br>{{ data.time }}:00</dd>
                </div>
              </dl>
            </section>
          {% endif %}

          <section class="registration-guide" aria-labelledby="registration-guide-heading">
            <h2 id="registration-guide-heading">入力について</h2>
            <ul>
              <li>「必須」の項目は必ず入力してください。</li>
              <li>パスワードは8〜72文字で設定します。</li>
              <li>入力内容は確認画面で修正できます。</li>
            </ul>
          </section>
        </aside>

        <div class="registration-form-panel">
          {% if errors is defined and errors %}
            <div class="alert alert-danger" role="alert">
              <h2 class="h5">入力内容をご確認ください</h2>
              <p>パスワードは安全のため、もう一度入力してください。</p>
              <ul class="mb-0">
                {% for message in errors %}
                  <li>{{ message }}</li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          <form action="{{ base_url() }}reserve/member/check" method="post" class="member-form">
            <input type="hidden" name="{{ csrf.key }}" value="{{ csrf.token }}">

            <section class="form-section" aria-labelledby="personal-heading">
              <header class="form-section__heading">
                <span>01</span>
                <div>
                  <h2 id="personal-heading">基本情報</h2>
                  <p>お名前と連絡先を入力してください。</p>
                </div>
              </header>

              <div class="form-grid form-grid--two">
                <div class="form-group">
                  <label for="familyName">姓</label>
                  <input type="text" id="familyName" name="familyName" class="form-control" maxlength="16" autocomplete="family-name" value="{{ userData.familyName|default('') }}">
                </div>

                <div class="form-group">
                  <label for="givenName">名</label>
                  <input type="text" id="givenName" name="givenName" class="form-control" maxlength="16" autocomplete="given-name" value="{{ userData.givenName|default('') }}">
                </div>

                <div class="form-group">
                  <label for="familyName_kana">セイ <span class="required-badge">必須</span></label>
                  <input type="text" id="familyName_kana" name="familyName_kana" class="form-control" maxlength="16" required value="{{ userData.familyName_kana|default('') }}">
                </div>

                <div class="form-group">
                  <label for="givenName_kana">メイ <span class="required-badge">必須</span></label>
                  <input type="text" id="givenName_kana" name="givenName_kana" class="form-control" maxlength="16" required value="{{ userData.givenName_kana|default('') }}">
                </div>

                <div class="form-group form-grid__wide">
                  <label for="email">メールアドレス <span class="required-badge">必須</span></label>
                  <input type="email" id="email" name="email" class="form-control" maxlength="255" required autocomplete="email" value="{{ userData.email|default('') }}">
                </div>

                <div class="form-group form-grid__wide">
                  <label for="email2">メールアドレス（確認用） <span class="required-badge">必須</span></label>
                  <input type="email" id="email2" name="email2" class="form-control" maxlength="255" required autocomplete="email" value="{{ userData.email2|default('') }}">
                </div>

                <div class="form-group form-grid__wide">
                  <label for="tel">電話番号（ハイフンなし） <span class="required-badge">必須</span></label>
                  <input type="tel" id="tel" name="tel" class="form-control" maxlength="20" required inputmode="tel" autocomplete="tel" value="{{ userData.tel|default('') }}">
                </div>
              </div>
            </section>

            <section class="form-section" aria-labelledby="password-heading">
              <header class="form-section__heading">
                <span>02</span>
                <div>
                  <h2 id="password-heading">パスワード</h2>
                  <p>ログイン時に使用するパスワードを設定します。</p>
                </div>
              </header>

              <div class="form-grid form-grid--two">
                <div class="form-group">
                  <label for="password">パスワード <span class="required-badge">必須</span></label>
                  <input type="password" id="password" name="password" class="form-control" minlength="8" maxlength="72" required autocomplete="new-password" aria-describedby="password-help">
                  <p id="password-help" class="form-text">半角英数字・記号の8〜72文字。空白は使用できません。</p>
                </div>

                <div class="form-group">
                  <label for="password2">パスワード（確認用） <span class="required-badge">必須</span></label>
                  <input type="password" id="password2" name="password2" class="form-control" minlength="8" maxlength="72" required autocomplete="new-password">
                </div>
              </div>
            </section>

            <section class="form-section" aria-labelledby="profile-heading">
              <header class="form-section__heading">
                <span>03</span>
                <div>
                  <h2 id="profile-heading">住所・プロフィール</h2>
                  <p>こちらの項目は任意です。</p>
                </div>
              </header>

              <div class="form-grid form-grid--two">
                <div class="form-group">
                  <label for="zip">郵便番号（ハイフンなし）</label>
                  <input type="text" id="zip" name="zip" class="form-control" maxlength="7" inputmode="numeric" autocomplete="postal-code" value="{{ userData.zip|default('') }}">
                </div>

                <div class="form-group">
                  <label for="pref">都道府県</label>
                  <select id="pref" name="pref" class="form-select" autocomplete="address-level1">
                    <option value="">選択してください</option>
                    {% for pref in prefs %}
                      <option value="{{ pref }}" {% if userData.pref|default('') == pref %}selected{% endif %}>{{ pref }}</option>
                    {% endfor %}
                  </select>
                </div>

                <div class="form-group">
                  <label for="city">市区町村</label>
                  <input type="text" id="city" name="city" class="form-control" maxlength="50" autocomplete="address-level2" value="{{ userData.city|default('') }}">
                </div>

                <div class="form-group">
                  <label for="address">番地・建物名</label>
                  <input type="text" id="address" name="address" class="form-control" maxlength="100" autocomplete="street-address" value="{{ userData.address|default('') }}">
                </div>

                <fieldset class="form-group birthday-fields form-grid__wide">
                  <legend>生年月日</legend>
                  <div>
                    <input type="number" id="birth_year" name="birth_year" min="1" max="9999" placeholder="2000" inputmode="numeric" aria-label="生まれた年" value="{{ userData.birth_year|default('') }}">
                    <label for="birth_year">年</label>
                    <input type="number" id="birth_month" name="birth_month" min="1" max="12" inputmode="numeric" aria-label="生まれた月" value="{{ userData.birth_month|default('') }}">
                    <label for="birth_month">月</label>
                    <input type="number" id="birth_day" name="birth_day" min="1" max="31" inputmode="numeric" aria-label="生まれた日" value="{{ userData.birth_day|default('') }}">
                    <label for="birth_day">日</label>
                  </div>
                </fieldset>

                <div class="form-group">
                  <label for="sex">性別</label>
                  <select id="sex" name="sex" class="form-select">
                    <option value="">選択してください</option>
                    <option value="男" {% if userData.sex|default('') == '男' %}selected{% endif %}>男</option>
                    <option value="女" {% if userData.sex|default('') == '女' %}selected{% endif %}>女</option>
                  </select>
                </div>

                <div class="form-group">
                  <label for="mail_magazine">メールマガジン</label>
                  <select id="mail_magazine" name="mail_magazine" class="form-select">
                    <option value="0" {% if userData.mail_magazine|default('0') == '0' %}selected{% endif %}>希望しない</option>
                    <option value="1" {% if userData.mail_magazine|default('0') == '1' %}selected{% endif %}>希望する</option>
                  </select>
                </div>
              </div>
            </section>

            <div class="form-actions">
              <p>入力内容は次の画面で確認できます。</p>
              <button type="submit" class="btn btn-primary">確認画面へ進む</button>
            </div>
          </form>
        </div>
      </div>
    </main>
  {% endautoescape %}
{% endblock main %}
