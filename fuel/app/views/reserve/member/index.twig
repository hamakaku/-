{% extends "layout.twig" %}

{% block main %}
  {% autoescape 'html' %}
    <main class="container py-5" style="max-width: 800px;">

      <h1>会員登録情報入力</h1>
      <p class="text-muted">必須の項目を入力し、確認画面へ進んでください。</p>
      {% if data %}
        <section class="card card-body mb-4" aria-label="予約内容">
          <h2 class="h5">予約内容</h2>
          <p class="mb-0">{{ data.instructor.name }} ／ {{ data.course.name }}<br>
            {{ data.date.year }}年{{ data.date.month }}月{{ data.date.day }}日
            （{{ data.date.week }}） {{ data.time }}:00</p>
        </section>
      {% endif %}

      {# 入力チェックのエラーを表示 #}
      {% if errors is defined and errors %}
        <div class="alert alert-danger" role="alert">
          <p>入力内容を確認してください。パスワードは再入力してください。</p>
          {% for message in errors %}
            <p>{{ message }}</p>
          {% endfor %}
        </div>
      {% endif %}

      <form action="{{ base_url() }}reserve/member/check" method="post" class="vstack gap-3">
		<input type="hidden" name="{{ csrf.key }}" value="{{ csrf.token }}">

        <div class="form-group">
          <label for="familyName">姓</label>
          <input
            type="text"
            id="familyName"
            name="familyName"
            class="form-control"
            maxlength="16"
            value="{{ userData.familyName|default('') }}"
          >
        </div>

        <div class="form-group">
          <label for="givenName">名</label>
          <input
            type="text"
            id="givenName"
            name="givenName"
            class="form-control"
            maxlength="16"
            value="{{ userData.givenName|default('') }}"
          >
        </div>

        <div class="form-group">
          <label for="familyName_kana">セイ（必須）</label>
          <input
            type="text"
            id="familyName_kana"
            name="familyName_kana"
            class="form-control"
            maxlength="16"
            required
            value="{{ userData.familyName_kana|default('') }}"
          >
        </div>

        <div class="form-group">
          <label for="givenName_kana">メイ（必須）</label>
          <input
            type="text"
            id="givenName_kana"
            name="givenName_kana"
            class="form-control"
            maxlength="16"
            required
            value="{{ userData.givenName_kana|default('') }}"
          >
        </div>

        <div class="form-group">
          <label for="email">メールアドレス（必須）</label>
          <input
            type="email"
            id="email"
            name="email"
            class="form-control"
            maxlength="255"
            required
            value="{{ userData.email|default('') }}"
          >
        </div>

        <div class="form-group">
          <label for="email2">メールアドレス・確認用（必須）</label>
          <input
            type="email"
            id="email2"
            name="email2"
            class="form-control"
            maxlength="255"
            required
            value="{{ userData.email2|default('') }}"
          >
        </div>

        <div class="form-group">
          <label for="tel">電話番号・ハイフンなし（必須）</label>
          <input
            type="tel"
            id="tel"
            name="tel"
            class="form-control"
            maxlength="20"
            required
            value="{{ userData.tel|default('') }}"
          >
        </div>

        <div class="form-group">
          <label for="password">パスワード（必須）</label>
          <input
            type="password"
            id="password"
            name="password"
            class="form-control"
            minlength="8"
            maxlength="72"
            required
            autocomplete="new-password"
            aria-describedby="password-help"
          >
          <p id="password-help" class="form-text">半角英数字・記号の8〜72文字。空白は使用できません。</p>
        </div>
        <div class="form-group">
          <label for="password2">パスワード・確認用（必須）</label>
          <input
            type="password"
            id="password2"
            name="password2"
            class="form-control"
            minlength="8"
            maxlength="72"
            required
            autocomplete="new-password"
          >
        </div>

        <div class="form-group">
          <label for="zip">郵便番号・ハイフンなし</label>
          <input
            type="text"
            id="zip"
            name="zip"
            class="form-control"
            maxlength="7"
            inputmode="numeric"
            value="{{ userData.zip|default('') }}"
          >
        </div>

        <div class="form-group">
          <label for="pref">都道府県</label>
          <select id="pref" name="pref" class="form-select">
            <option value="">選択してください</option>
            {% for pref in prefs %}
              <option value="{{ pref }}" {% if userData.pref|default('') == pref %}selected{% endif %}>{{ pref }}</option>
            {% endfor %}
          </select>
        </div>

        <div class="form-group">
          <label for="city">市区町村</label>
          <input
            type="text"
            id="city"
            name="city"
            class="form-control"
            maxlength="50"
            value="{{ userData.city|default('') }}"
          >
        </div>

        <div class="form-group">
          <label for="address">番地・建物名</label>
          <input
            type="text"
            id="address"
            name="address"
            class="form-control"
            maxlength="100"
            value="{{ userData.address|default('') }}"
          >
        </div>


        <fieldset class="form-group">
          <legend>生年月日</legend>


          <input
            type="number"
            id="birth_year"
            name="birth_year"
            min="1"
            max="9999"
            placeholder="例：2000"
            value="{{ userData.birth_year|default('') }}"
          >
          <label for="birth_year">年</label>


          <input
            type="number"
            id="birth_month"
            name="birth_month"
            min="1"
            max="12"
            value="{{ userData.birth_month|default('') }}"
          >
          <label for="birth_month">月</label>

          <input
            type="number"
            id="birth_day"
            name="birth_day"
            min="1"
            max="31"
            value="{{ userData.birth_day|default('') }}"
          >
          <label for="birth_day">日</label>
        </fieldset>

        <div class="form-group">
          <label for="sex">性別</label>
          <select id="sex" name="sex" class="form-control">
            <option value="">選択してください</option>
            <option
              value="男"
              {% if userData.sex|default('') == '男' %}selected{% endif %}
            >
              男
            </option>
            <option
              value="女"
              {% if userData.sex|default('') == '女' %}selected{% endif %}
            >
              女
            </option>
          </select>
        </div>


        <div class="form-group">
          <label for="mail_magazine">メールマガジン</label>
          <select id="mail_magazine" name="mail_magazine" class="form-select">
            <option value="0" {% if userData.mail_magazine|default('0') == '0' %}selected{% endif %}>希望しない</option>
            <option value="1" {% if userData.mail_magazine|default('0') == '1' %}selected{% endif %}>希望する</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary mt-4">
          確認画面へ
        </button>

      </form>
    </main>
  {% endautoescape %}
{% endblock main %}
