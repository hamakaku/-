{% extends "layout.twig" %}

{#
  予約確定（会員登録せず予約へ・会員登録して予約へ 共通。仕様書 p.4）

  渡される値: title / reserve_id（予約番号）
#}

{% block main %}
  <main class="completion-page">
    <ol class="progress-steps" aria-label="予約手続きの進捗">
      <li class="is-complete"><span>1</span>情報入力</li>
      <li class="is-complete"><span>2</span>入力確認</li>
      <li class="is-complete"><span>3</span>予約確認</li>
      <li class="is-current" aria-current="step"><span>4</span>予約完了</li>
    </ol>
    <div class="completion-mark" aria-hidden="true">✓</div>
    <h1>{{ title }}</h1>

    <p class="completion-message">予約が完了しました。</p>
    {% if reserve_id is defined and reserve_id %}
      <p class="reservation-number"><span>予約番号</span><strong>{{ reserve_id }}</strong></p>
    {% endif %}
    <p class="text-muted">ご予約いただきありがとうございます。</p>

    <div class="form-actions form-actions--center">
      <a class="btn btn-primary" href="{{ base_url() }}">トップへ戻る</a>
    </div>
  </main>
{% endblock main %}
